SESSION_DRIVER=database
CACHE_DRIVER=database
QUEUE_CONNECTION=database
BROADCAST_DRIVER=log

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=jephbesaus07@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
